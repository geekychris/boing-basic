#!/usr/bin/env python3
"""genbind - write Boing BASIC bindings (bindings/*.bi) from the AmigaOS 4 SDK.

    tools/genbind [--sdk DIR] [--out DIR] [--slots FILE] [lib ...]

Reads the SDK's interface descriptions (Include/interfaces/*.xml) for the Declare lines and
the C headers (Include/include_h) for the numeric #defines, which become Consts.

Every Declare names its interface slot with `Alias "#n"` (n = the function's index in the
interface's function table, Obtain = 0), so the runtime calls through the table without a
name lookup. Functions that can't be called with 32-bit integer arguments (float, double,
64-bit or struct-by-value arguments or results) and variadic ones (use the TagList form of the
function instead: AllocDosObject, not AllocDosObjectTags) are left out with a comment.

--slots also writes a C table (lib, interface, function, slot, argc) the OS4 runtime uses for
Declares written by hand without a "#n" alias.
"""
import argparse
import ast
import os
import re
import sys
import xml.etree.ElementTree as ET

HERE = os.path.dirname(os.path.abspath(__file__))
DEFAULT_SDK = os.path.normpath(os.path.join(HERE, "../../refs/os4-sdk/base/Include"))

# Words a Declare or argument may not be called (BASIC keywords and builtins). A function with
# one of these names gets its library's prefix (Dos_Open); an argument gets a trailing _.
RESERVED = set("""
