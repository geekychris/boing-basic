/* builtins.def - the built-in functions and subs.
 *
 * BI(id, name, rettype, minargs, maxargs, params, defaults, cfn, flags, vmexpr)
 *   params:   one char per parameter, the type the argument is converted to:
 *             s String  l Long  i Integer  d Double  f Single  D Date  b Boolean
 *             c Currency  v Variant (passed as const bb_value*)  a array (bb_array*)
 *             T compare mode (Long; defaults to the module's Option Compare)
 *   defaults: comma separated, one per parameter: empty = required, M = Missing,
 *             T = module compare mode, otherwise a literal (number or "")
 *   cfn:      runtime function the C back end calls (args in params order)
 *   vmexpr:   what the VM does (macros from vm.c: S(n) L(n) D(n) V(n) ...; RS RL ...)
 * Included by the compiler (table) and the VM (dispatch).
 */
BI(LEN, "Len", T_LONG, 1, 1, "s", "", "bb_len", BIF_SPECIAL, RL(bb_len(S(0))))
BI(LEFT, "Left", T_STRING, 2, 2, "sl", ",", "bb_left", BIF_STRSUFFIX, RS(bb_left(S(0), L(1))))
BI(RIGHT, "Right", T_STRING, 2, 2, "sl", ",", "bb_right", BIF_STRSUFFIX, RS(bb_right(S(0), L(1))))
BI(MID, "Mid", T_STRING, 2, 3, "sll", ",,-1", "bb_mid", BIF_STRSUFFIX, RS(bb_mid(S(0), L(1), L(2))))
BI(INSTR, "InStr", T_LONG, 2, 4, "lssT", ",,,T", "bb_instr", BIF_SPECIAL, RL(bb_instr(L(0), S(1), S(2), (int)L(3))))
BI(INSTRREV, "InStrRev", T_LONG, 2, 4, "sslT", ",,-1,T", "bb_instrrev", 0, RL(bb_instrrev(S(0), S(1), L(2), (int)L(3))))
BI(LCASE, "LCase", T_STRING, 1, 1, "s", "", "bb_lcase", BIF_STRSUFFIX, RS(bb_lcase(S(0))))
BI(UCASE, "UCase", T_STRING, 1, 1, "s", "", "bb_ucase", BIF_STRSUFFIX, RS(bb_ucase(S(0))))
BI(TRIM, "Trim", T_STRING, 1, 1, "s", "", "bb_trim", BIF_STRSUFFIX, RS(bb_trim(S(0))))
BI(LTRIM, "LTrim", T_STRING, 1, 1, "s", "", "bb_ltrim", BIF_STRSUFFIX, RS(bb_ltrim(S(0))))
BI(RTRIM, "RTrim", T_STRING, 1, 1, "s", "", "bb_rtrim", BIF_STRSUFFIX, RS(bb_rtrim(S(0))))
BI(SPACE, "Space", T_STRING, 1, 1, "l", "", "bb_space", BIF_STRSUFFIX, RS(bb_space(L(0))))
BI(STRING, "String", T_STRING, 2, 2, "lv", ",", "bb_string_n", BIF_STRSUFFIX, RS(bb_string_n(L(0), V(1))))
BI(REPLACE, "Replace", T_STRING, 3, 6, "sssllT", ",,,1,-1,T", "bb_replace", 0, RS(bb_replace(S(0), S(1), S(2), L(3), L(4), (int)L(5))))
BI(SPLIT, "Split", T_ARRAY, 1, 4, "sslT", ", ,-1,T", "bb_split", 0, RA(bb_split(S(0), S(1), L(2), (int)L(3))))
BI(JOIN, "Join", T_STRING, 1, 2, "as", ", ", "bb_join", 0, RS(bb_join(A(0), S(1))))
BI(STRCOMP, "StrComp", T_LONG, 2, 3, "ssT", ",,T", "bb_strcomp", 0, RL(bb_strcomp(S(0), S(1), L(2))))
BI(STRREVERSE, "StrReverse", T_STRING, 1, 1, "s", "", "bb_strreverse", 0, RS(bb_strreverse(S(0))))
BI(CHR, "Chr", T_STRING, 1, 1, "l", "", "bb_chr", BIF_STRSUFFIX, RS(bb_chr(L(0))))
BI(CHRW, "ChrW", T_STRING, 1, 1, "l", "", "bb_chr", BIF_STRSUFFIX, RS(bb_chr(L(0))))
BI(ASC, "Asc", T_LONG, 1, 1, "s", "", "bb_asc", 0, RL(bb_asc(S(0))))
BI(ASCW, "AscW", T_LONG, 1, 1, "s", "", "bb_asc", 0, RL(bb_asc(S(0))))
BI(VAL, "Val", T_DOUBLE, 1, 1, "s", "", "bb_val", 0, RD(bb_val(S(0))))
BI(STR, "Str", T_STRING, 1, 1, "v", "", "bb_str_fn", BIF_STRSUFFIX, RS(bb_str_fn(V(0))))
BI(HEX, "Hex", T_STRING, 1, 1, "v", "", "bb_hex", BIF_STRSUFFIX, RS(bb_hex(V(0))))
BI(OCT, "Oct", T_STRING, 1, 1, "v", "", "bb_oct", BIF_STRSUFFIX, RS(bb_oct(V(0))))
BI(FORMAT, "Format", T_STRING, 1, 4, "vs", ",", "bb_format", BIF_STRSUFFIX, RS(bb_format(V(0), S(1))))
BI(LSETF, "__lset", T_STRING, 2, 2, "ss", ",", "bb_lset", 0, RS(bb_lset(S(0), S(1))))
BI(RSETF, "__rset", T_STRING, 2, 2, "ss", ",", "bb_rset", 0, RS(bb_rset(S(0), S(1))))

BI(ABS, "Abs", T_VARIANT, 1, 1, "v", "", "bb_abs", BIF_SPECIAL, RV(bb_abs(V(0))))
BI(SGN, "Sgn", T_VARIANT, 1, 1, "v", "", "bb_sgn", BIF_SPECIAL, RV(bb_sgn(V(0))))
BI(INT, "Int", T_VARIANT, 1, 1, "v", "", "bb_int_fn", BIF_SPECIAL, RV(bb_int_fn(V(0))))
BI(FIX, "Fix", T_VARIANT, 1, 1, "v", "", "bb_fix", BIF_SPECIAL, RV(bb_fix(V(0))))
BI(ROUND, "Round", T_VARIANT, 1, 2, "vl", ",0", "bb_round", BIF_SPECIAL, RV(bb_round(V(0), L(1))))
BI(SQR, "Sqr", T_DOUBLE, 1, 1, "d", "", "bb_sqr", 0, RD(bb_sqr(D(0))))
BI(SIN, "Sin", T_DOUBLE, 1, 1, "d", "", "sin", 0, RD(sin(D(0))))
BI(COS, "Cos", T_DOUBLE, 1, 1, "d", "", "cos", 0, RD(cos(D(0))))
BI(TAN, "Tan", T_DOUBLE, 1, 1, "d", "", "tan", 0, RD(tan(D(0))))
BI(ATN, "Atn", T_DOUBLE, 1, 1, "d", "", "atan", 0, RD(atan(D(0))))
BI(LOG, "Log", T_DOUBLE, 1, 1, "d", "", "bb_log", 0, RD(bb_log(D(0))))
BI(EXP, "Exp", T_DOUBLE, 1, 1, "d", "", "bb_exp", 0, RD(bb_exp(D(0))))
BI(RND, "Rnd", T_SINGLE, 0, 1, "v", "M", "bb_rnd", BIF_NOARGS_OK, RF(bb_rnd(V(0))))
BI(RANDOMIZE, "Randomize", T_VOID, 0, 1, "v", "M", "bb_randomize", BIF_SUB, RN(bb_randomize(V(0))))

BI(ISNUMERIC, "IsNumeric", T_BOOLEAN, 1, 1, "v", "", "bb_isnumeric", 0, RB(bb_isnumeric(V(0))))
BI(ISDATE, "IsDate", T_BOOLEAN, 1, 1, "v", "", "bb_isdate", 0, RB(bb_isdate(V(0))))
BI(ISEMPTY, "IsEmpty", T_BOOLEAN, 1, 1, "v", "", "", BIF_SPECIAL, RB(V(0)->type == BB_EMPTY ? BB_TRUE : BB_FALSE))
BI(ISNULL, "IsNull", T_BOOLEAN, 1, 1, "v", "", "", BIF_SPECIAL, RB(V(0)->type == BB_NULL ? BB_TRUE : BB_FALSE))
BI(ISOBJECT, "IsObject", T_BOOLEAN, 1, 1, "v", "", "", BIF_SPECIAL, RB(V(0)->type == BB_OBJECT ? BB_TRUE : BB_FALSE))
BI(ISMISSING, "IsMissing", T_BOOLEAN, 1, 1, "v", "", "", BIF_SPECIAL, RB((V(0)->type == BB_ERROR && (V(0)->flags & BB_VF_MISSING)) ? BB_TRUE : BB_FALSE))
BI(ISARRAY, "IsArray", T_BOOLEAN, 1, 1, "v", "", "", BIF_SPECIAL, RB((V(0)->type & BB_ARRAY) ? BB_TRUE : BB_FALSE))
BI(TYPENAME, "TypeName", T_STRING, 1, 1, "v", "", "bb_typename", BIF_SPECIAL, RS(bb_typename(V(0))))
BI(VARTYPE, "VarType", T_INTEGER, 1, 1, "v", "", "bb_vartype", BIF_SPECIAL, RI((bb_int)bb_vartype(V(0))))
BI(LBOUND, "LBound", T_LONG, 1, 2, "al", ",1", "bb_arr_lbound", BIF_SPECIAL, RL(bb_arr_lbound(A(0), (int)L(1))))
BI(UBOUND, "UBound", T_LONG, 1, 2, "al", ",1", "bb_arr_ubound", BIF_SPECIAL, RL(bb_arr_ubound(A(0), (int)L(1))))
BI(ARRAY, "Array", T_VARIANT, 0, 255, "", "", "bb_array_fn", BIF_SPECIAL | BIF_VARARGS, RV(bb_array_fn(argc, args)))
BI(CHOOSE, "Choose", T_VARIANT, 2, 255, "l", "", "bb_choose", BIF_SPECIAL | BIF_VARARGS, RV(bb_choose(L(0), argc - 1, args + 1)))
BI(IIF, "IIf", T_VARIANT, 3, 3, "vvv", ",,", "bb_iif", 0, RV(bb_iif(V(0), V(1), V(2))))

BI(NOW, "Now", T_DATE, 0, 0, "", "", "bb_now", BIF_NOARGS_OK, RDT(bb_now()))
BI(DATE, "Date", T_DATE, 0, 0, "", "", "bb_date_fn", BIF_NOARGS_OK, RDT(bb_date_fn()))
BI(TIME, "Time", T_DATE, 0, 0, "", "", "bb_time_fn", BIF_NOARGS_OK, RDT(bb_time_fn()))
BI(TIMER, "Timer", T_SINGLE, 0, 0, "", "", "bb_timer", BIF_NOARGS_OK, RF(bb_timer()))
BI(DATESERIAL, "DateSerial", T_DATE, 3, 3, "lll", ",,", "bb_dateserial", 0, RDT(bb_dateserial(L(0), L(1), L(2))))
BI(TIMESERIAL, "TimeSerial", T_DATE, 3, 3, "lll", ",,", "bb_timeserial", 0, RDT(bb_timeserial(L(0), L(1), L(2))))
BI(DATEVALUE, "DateValue", T_DATE, 1, 1, "D", "", "floor", 0, RDT(floor(D(0))))
BI(TIMEVALUE, "TimeValue", T_DATE, 1, 1, "D", "", "bb_timevalue_", 0, RDT(D(0) - floor(D(0))))
BI(YEAR, "Year", T_INTEGER, 1, 1, "D", "", "bb_year", 0, RI((bb_int)bb_year(D(0))))
BI(MONTH, "Month", T_INTEGER, 1, 1, "D", "", "bb_month", 0, RI((bb_int)bb_month(D(0))))
BI(DAY, "Day", T_INTEGER, 1, 1, "D", "", "bb_day", 0, RI((bb_int)bb_day(D(0))))
BI(HOUR, "Hour", T_INTEGER, 1, 1, "D", "", "bb_hour", 0, RI((bb_int)bb_hour(D(0))))
BI(MINUTE, "Minute", T_INTEGER, 1, 1, "D", "", "bb_minute", 0, RI((bb_int)bb_minute(D(0))))
BI(SECOND, "Second", T_INTEGER, 1, 1, "D", "", "bb_second", 0, RI((bb_int)bb_second(D(0))))
BI(WEEKDAY, "Weekday", T_INTEGER, 1, 2, "Dl", ",1", "bb_weekday", 0, RI((bb_int)bb_weekday(D(0), L(1))))
BI(DATEADD, "DateAdd", T_DATE, 3, 3, "sdD", ",,", "bb_dateadd", 0, RDT(bb_dateadd(S(0), D(1), D(2))))
BI(DATEDIFF, "DateDiff", T_LONG, 3, 5, "sDD", ",,", "bb_datediff", 0, RL(bb_datediff(S(0), D(1), D(2))))
BI(DATEPART, "DatePart", T_INTEGER, 2, 4, "sD", ",", "bb_datepart", 0, RI((bb_int)bb_datepart(S(0), D(1))))
BI(MONTHNAME, "MonthName", T_STRING, 1, 2, "lb", ",0", "bb_monthname", 0, RS(bb_monthname(L(0), B(1))))
BI(WEEKDAYNAME, "WeekdayName", T_STRING, 1, 3, "lb", ",0", "bb_weekdayname", 0, RS(bb_weekdayname(L(0), B(1))))

BI(COMMAND, "Command", T_STRING, 0, 0, "", "", "bb_command", BIF_NOARGS_OK | BIF_STRSUFFIX, RS(bb_command()))
BI(ENVIRON, "Environ", T_STRING, 1, 1, "v", "", "bb_environ", BIF_STRSUFFIX, RS(bb_environ(V(0))))
BI(SHELL, "Shell", T_LONG, 1, 2, "s", "", "bb_shell", 0, RL(bb_shell(S(0))))
BI(BEEP, "Beep", T_VOID, 0, 0, "", "", "bb_beep", BIF_SUB | BIF_NOARGS_OK, RN(bb_beep()))
BI(SLEEP, "Sleep", T_VOID, 1, 1, "l", "", "bb_sleep_ms", BIF_SUB, RN(bb_sleep_ms(L(0))))
BI(DOEVENTS, "DoEvents", T_INTEGER, 0, 0, "", "", "bb_doevents", BIF_NOARGS_OK, RI(bb_doevents()))
BI(RGB, "RGB", T_LONG, 3, 3, "lll", ",,", "bb_rgb", 0, RL(bb_rgb(L(0), L(1), L(2))))
BI(MSGBOX, "MsgBox", T_LONG, 1, 5, "vlv", ",0,M", "bb_msgbox", 0, RL(bb_msgbox(V(0), L(1), V(2))))
BI(INPUTBOX, "InputBox", T_STRING, 1, 3, "vvv", ",M,M", "bb_inputbox", BIF_STRSUFFIX, RS(bb_inputbox(V(0), V(1), V(2))))
BI(ERL, "Erl", T_LONG, 0, 0, "", "", "bb_erl", BIF_NOARGS_OK, RL(bb_erl()))
BI(ERRORF, "Error", T_STRING, 0, 1, "v", "M", "bb_error_fn", BIF_STRSUFFIX | BIF_NOARGS_OK, RS(bb_error_fn(V(0))))

BI(FREEFILE, "FreeFile", T_INTEGER, 0, 1, "", "", "bb_freefile", BIF_NOARGS_OK, RI((bb_int)bb_freefile()))
BI(EOF, "EOF", T_BOOLEAN, 1, 1, "l", "", "bb_eof", 0, RB(bb_eof(L(0))))
BI(LOF, "LOF", T_LONG, 1, 1, "l", "", "bb_lof", 0, RL(bb_lof(L(0))))
BI(LOC, "Loc", T_LONG, 1, 1, "l", "", "bb_loc", 0, RL(bb_loc(L(0))))
BI(SEEKF, "Seek", T_LONG, 1, 1, "l", "", "bb_seek_get", 0, RL(bb_seek_get(L(0))))
BI(FILELEN, "FileLen", T_LONG, 1, 1, "s", "", "bb_filelen", 0, RL(bb_filelen(S(0))))
BI(DIR, "Dir", T_STRING, 0, 2, "vl", "M,0", "bb_dir", BIF_STRSUFFIX | BIF_NOARGS_OK, RS(bb_dir(V(0), L(1))))
BI(CURDIR, "CurDir", T_STRING, 0, 1, "", "", "bb_curdir", BIF_STRSUFFIX | BIF_NOARGS_OK, RS(bb_curdir()))
BI(INPUTF, "Input", T_STRING, 2, 2, "ll", ",", "bb_input_chars", BIF_STRSUFFIX, RS(bb_input_chars(L(0), L(1))))
BI(KILL, "Kill", T_VOID, 1, 1, "s", "", "bb_kill", BIF_SUB, RN(bb_kill(S(0))))
BI(MKDIR, "MkDir", T_VOID, 1, 1, "s", "", "bb_mkdir", BIF_SUB, RN(bb_mkdir(S(0))))
BI(RMDIR, "RmDir", T_VOID, 1, 1, "s", "", "bb_rmdir", BIF_SUB, RN(bb_rmdir(S(0))))
BI(CHDIR, "ChDir", T_VOID, 1, 1, "s", "", "bb_chdir", BIF_SUB, RN(bb_chdir(S(0))))
BI(FILECOPY, "FileCopy", T_VOID, 2, 2, "ss", ",", "bb_filecopy", BIF_SUB, RN(bb_filecopy(S(0), S(1))))
