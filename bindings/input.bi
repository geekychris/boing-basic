' input.bi - input.device, generated by tools/genbind from the AmigaOS 4 SDK. Don't edit.
' Functions that can't be called with 32-bit integer arguments, and variadic ones
' (use the TagList form), are left out. Pointers are Long; C strings are ByVal As String
' (pass vbNullString for NULL, Space(n) for a buffer the function fills).

' --- interface "main" ---
Declare Function PeekQualifier Lib "input.device" Alias "#4" () As Long

' --- constants ---
' devices/input.h
Const IDERR_BadName = 1
Const IDERR_OutOfMemory = 2
Const IDERR_NameTooLong = 3
Const IDERR_AlreadyInstalled = 4
Const IDERR_NotInstalled = 5
