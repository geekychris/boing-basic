; a household budget: the README's screenshot and the guest smoke test use this script
SETCELL A1 Household budget 2026
BOLD ON
SETCELL A3 Item
SETCELL B3 Jan
SETCELL C3 Feb
SETCELL D3 Mar
SETCELL E3 Total
SELECT A3:E3
BOLD ON
ALIGN CENTER
SETCELL A4 Rent
SETCELL B4 950
SETCELL C4 950
SETCELL D4 950
SETCELL A5 Food
SETCELL B5 412.5
SETCELL C5 380.2
SETCELL D5 455
SETCELL A6 Transport
SETCELL B6 120
SETCELL C6 95.75
SETCELL D6 140
SETCELL A7 Fun
SETCELL B7 80
SETCELL C7 150
SETCELL D7 60
SETCELL E4 =SUM(B4:D4)
SELECT E4:E7
FILLDOWN
SETCELL A8 Total
SETCELL B8 =SUM(B4:B7)
SELECT B8:E8
FILLRIGHT
BOLD ON
SELECT B4:E8
FORMAT THOUSANDS2
SETCELL A10 Average month
SETCELL B10 =AVERAGE(B8:D8)
SETCELL A11 Food share
SETCELL B11 =E5/E8
SELECT B11
FORMAT PERCENT2
SETCELL A12 Over 1500?
SETCELL B12 =IF(MAX(B8:D8)>1500, "yes", "no")
COLWIDTH A 96
CHART BAR A3:D7 Spending by month
SELECT A1
GETCELL E8
GETCELL B10
GETCELL B11
GETCELL B12
