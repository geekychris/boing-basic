# Boing BASIC project: real calls into AmigaOS 4 libraries through the generated bindings and
# hand-written Declares. Run: tools/os4guest.py bas tests-os4/bindings/libs.bbp both
# Expected output: libs.out (deterministic: no addresses or times are printed)
Name=BindingsTest
Startup=Sub Main
Module=libs.bas
Module=../../bindings/exec.bi
Module=../../bindings/dos.bi
Module=../../bindings/utility.bi
Module=../../bindings/intuition.bi
Module=../../bindings/graphics.bi
Module=../../bindings/locale.bi
