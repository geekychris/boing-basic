# AmiForge GUI (edit with Tools > GUI Designer)
window name=penwright title="Penwright" width=660 height=520 resizable=1 dropfiles=1 iconify=1
vlayout id=root
  toolbar id=tb weight=0 textonly=1
    tool id=tbNew text="New" hint="New document (Amiga-T)" menu=mnuNewDoc
    tool id=tbOpen text="Open" hint="Open (Amiga-O)" menu=mnuOpen
    tool id=tbSave text="Save" hint="Save (Amiga-S)" menu=mnuSave
    tool id=tbPrint text="Print" hint="Print" menu=mnuPrint
    tool separator=1
    tool id=tbUndo text="Undo" hint="Undo (Amiga-Z)" menu=mnuUndo
    tool id=tbRedo text="Redo" hint="Redo (Amiga-Y)" menu=mnuRedo
    tool separator=1
    tool id=tbCut text="Cut" hint="Cut (Amiga-X)" menu=mnuCut
    tool id=tbCopy text="Copy" hint="Copy (Amiga-C)" menu=mnuCopy
    tool id=tbPaste text="Paste" hint="Paste (Amiga-V)" menu=mnuPaste
    tool separator=1
    tool id=tbFind text="Find" hint="Find (Amiga-F)" menu=mnuFind
    tool id=tbSpell text="Spelling" hint="Next misspelt word (Amiga-K)" menu=mnuSpell
  hlayout weight=0
    chooser id=style items="Body|Heading 1|Heading 2|Heading 3|Quote|Bullet|Code" selected=0 weight=0 hint="Paragraph style"
    chooser id=size items="8|9|10|11|12|14|16|18|20|24|28|32|36|48" selected=4 weight=0 hint="Text size (points)"
    button id=bold text="B" weight=0 hint="Bold (Amiga-B)"
    button id=italic text="I" weight=0 hint="Italic (Amiga-I)"
    button id=under text="U" weight=0 hint="Underline (Amiga-U)"
    chooser id=colour items="Automatic|Red|Orange|Ochre|Green|Teal|Blue|Violet|Magenta|Grey|Brown|Sea green|Indigo|Pink|Slate|White" selected=0 weight=0 hint="Text colour"
    chooser id=align items="Left|Centre|Right|Justify" selected=0 weight=0 hint="Alignment"
    space
  canvas id=page width=480 height=300 fill=1 contextmenu=mnuCtx
  statusbar id=sb panels="Ready|Para 1/1|12pt" widths="0|140|60"
  commondialog id=dlg title="Penwright" filter="Documents|#?.(pwd|rtf|txt)"
  timer id=tick interval=250 enabled=1
menu id=mnuProject text="Project"
  menu id=mnuNew text="New" key=N
  menu id=mnuOpen text="Open..." key=O
  menu id=mnuRecent text="Open recent"
    menu id=mnuRecent0 text="(none)" disabled=1
    menu id=mnuRecent1 text="(empty)" hidden=1
    menu id=mnuRecent2 text="(empty)" hidden=1
    menu id=mnuRecent3 text="(empty)" hidden=1
    menu id=mnuRecent4 text="(empty)" hidden=1
    menu id=mnuRecent5 text="(empty)" hidden=1
    menu id=mnuRecent6 text="(empty)" hidden=1
    menu id=mnuRecent7 text="(empty)" hidden=1
  menu id=mnuSave text="Save" key=S
  menu id=mnuSaveAs text="Save as..."
  menu text=-
  menu id=mnuExpRtf text="Export RTF..."
  menu id=mnuExpHtml text="Export HTML..."
  menu id=mnuExpTxt text="Export text..."
  menu id=mnuPrint text="Print..." key=P
  menu text=-
  menu id=mnuInfo text="Document info..."
  menu id=mnuHelp text="Help..."
  menu id=mnuAbout text="About..."
  menu text=-
  menu id=mnuQuit text="Quit" key=Q
menu id=mnuEdit text="Edit"
  menu id=mnuUndo text="Undo" key=Z
  menu id=mnuRedo text="Redo" key=Y
  menu text=-
  menu id=mnuCut text="Cut" key=X
  menu id=mnuCopy text="Copy" key=C
  menu id=mnuPaste text="Paste" key=V
  menu id=mnuSelAll text="Select all" key=A
  menu text=-
  menu id=mnuFind text="Find..." key=F
  menu id=mnuFindNext text="Find next" key=G
  menu id=mnuReplace text="Replace all..." key=R
menu id=mnuText text="Text"
  menu id=mnuBold text="Bold" key=B
  menu id=mnuItalic text="Italic" key=I
  menu id=mnuUnder text="Underline" key=U
  menu id=mnuStrike text="Strike through"
  menu id=mnuPlain text="Plain" key=P
  menu text=-
  menu id=mnuBigger text="Bigger" key=>
  menu id=mnuSmaller text="Smaller" key=<
menu id=mnuPara text="Paragraph"
  menu id=mnuStBody text="Body" key=0
  menu id=mnuStH1 text="Heading 1" key=1
  menu id=mnuStH2 text="Heading 2" key=2
  menu id=mnuStH3 text="Heading 3" key=3
  menu id=mnuStQuote text="Quote" key=4
  menu id=mnuStBullet text="Bullet" key=5
  menu id=mnuStCode text="Code" key=6
  menu text=-
  menu id=mnuAlLeft text="Align left" key=[
  menu id=mnuAlCenter text="Centre" key=|
  menu id=mnuAlRight text="Align right" key=]
  menu id=mnuAlJustify text="Justify" key=J
menu id=mnuTools text="Tools"
  menu id=mnuSpell text="Check spelling" key=K
  menu id=mnuLive text="Mark misspelt words" checkable=1 checked=1
  menu id=mnuCount text="Word count" key=W
  menu id=mnuMarks text="Show paragraph marks" checkable=1 key=M
  menu text=-
  menu id=mnuAutosave text="Autosave every 2 minutes" checkable=1 checked=1
  menu id=mnuDefSize text="Default text size..."
menu id=mnuWindow text="Documents"
  menu id=mnuNewDoc text="New document" key=T
  menu id=mnuCloseDoc text="Close document" key=.
  menu text=-
  menu id=mnuDoc0 text="Untitled" radio=1 checked=1
  menu id=mnuDoc1 text="(document)" radio=1 hidden=1
  menu id=mnuDoc2 text="(document)" radio=1 hidden=1
  menu id=mnuDoc3 text="(document)" radio=1 hidden=1
  menu id=mnuDoc4 text="(document)" radio=1 hidden=1
  menu id=mnuDoc5 text="(document)" radio=1 hidden=1
  menu id=mnuDoc6 text="(document)" radio=1 hidden=1
  menu id=mnuDoc7 text="(document)" radio=1 hidden=1
menu id=mnuCtx text="Edit" hidden=1
  menu id=mnuXCut text="Cut"
  menu id=mnuXCopy text="Copy"
  menu id=mnuXPaste text="Paste"
  menu text=-
  menu id=mnuXBold text="Bold"
  menu id=mnuXItalic text="Italic"
  menu id=mnuXSpell text="Check spelling"
